#!/bin/sh
# Copyright 2026 514 LLC d/b/a OpenGlow
# Written by Scott Wiederhold
# https://community.openglow.org
# SPDX-License-Identifier:    MIT
### BEGIN INIT INFO
# Provides:          forgectrl
# Required-Start:    $network $syslog
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: ForgeFIRM control daemon (camera MJPEG service)
### END INIT INFO

DAEMON=/usr/bin/forgectrl
PIDFILE=/var/run/forgectrl.pid
FIFO=/var/run/forgectrl.stderr
# The daemon's own stop takes seconds: its controller ended in order, the
# listeners' connections ended, the cooling engine's last writes. Its own
# bounds, one after another, reach about a minute. This long, and then it
# is killed.
STOP_WAIT_S=90

# The daemon runs under a small respawn wrapper: forgectrl supervises
# the motion controllers and holds the pulse-device broker, so a crash
# must not leave the machine unmanaged. Stopping the service stops the
# wrapper, then waits for the daemon: the daemon's own stop ends its
# controller in order, busy or idle (the safing pair at once, motion
# decelerating and the laser latched; then SIGTERM, and SIGKILL past its
# grace), and only after the daemon has gone does anything else run, a
# restart's start included. A daemon still running STOP_WAIT_S after the
# stop is killed; a controller still running then dies with it, and the
# kernel's dead man's switch halts a run it was playing, as at a crash. A
# GRBL controller's homing runner ends with its controller; after such a
# kill it can home on to its own end, and the next daemon stands by until
# it is gone. A stop that leaves the daemon running exits 1.
#
# The daemon starts with a fixed environment (env -i, the search path
# alone): nothing the caller's shell exports reaches it or a controller.
#
# Logging: the daemon emits through syslog itself (rsyslog files it
# under /data/log/forgefirm/forgectrl). Anything that still reaches its
# stdout/stderr - a loader error, a helper's output, an abort message -
# flows through a fifo into a `logger` relay under the same program
# name. The relay holds the fifo open read-write so it never sees EOF
# and survives daemon respawns.

# The daemon's processes. Match the actual executable, never the process
# name: this script - and the parent shell of a "restart", which runs stop
# as a child - are also named forgectrl. Only a process whose exe IS the
# daemon binary is the daemon.
daemon_pids() {
    for p in $(pidof forgectrl 2>/dev/null); do
        [ "$(readlink -f /proc/$p/exe 2>/dev/null)" = "$DAEMON" ] && echo "$p"
    done
}

# Waits up to $1 s for every daemon process to be gone; 0 when they are.
daemon_gone_within() {
    i=0
    while [ -n "$(daemon_pids)" ]; do
        [ $i -lt "$1" ] || return 1
        sleep 1
        i=$((i + 1))
    done
    return 0
}

case "$1" in
  start)
    echo "Starting forgectrl"
    rm -f "$FIFO"
    mkfifo -m 600 "$FIFO"
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    start-stop-daemon -S -q -p $PIDFILE -m -b -x /bin/sh -- -c "
      trap 'kill \$CHILD \$RELAY 2>/dev/null; exit 0' TERM
      # The wrapper must survive memory pressure to respawn the daemon
      # (the daemon itself runs at -900, controllers at -500).
      echo -1000 > /proc/self/oom_score_adj 2>/dev/null
      logger -t forgectrl -p daemon.warning <> $FIFO &
      RELAY=\$!
      while :; do
        $DAEMON > $FIFO 2>&1 &
        CHILD=\$!
        wait \$CHILD
        RC=\$?
        [ \$RC -eq 0 ] && { kill \$RELAY 2>/dev/null; exit 0; }
        logger -t forgectrl -p daemon.err \"exited (\$RC) - respawning in 5 s\"
        sleep 5 &
        CHILD=\$!
        wait \$CHILD
      done"
    ;;
  stop)
    echo "Stopping forgectrl"
    # The wrapper's trap sends the daemon SIGTERM and leaves; a daemon a
    # dead wrapper orphaned gets its own.
    start-stop-daemon -K -q -p $PIDFILE
    pids=$(daemon_pids)
    [ -z "$pids" ] || kill $pids 2>/dev/null
    if ! daemon_gone_within $STOP_WAIT_S; then
        echo "forgectrl did not stop in $STOP_WAIT_S s - killing it"
        pids=$(daemon_pids)
        [ -z "$pids" ] || kill -9 $pids 2>/dev/null
        if ! daemon_gone_within 5; then
            echo "forgectrl is still running"
            exit 1
        fi
    fi
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop || exit 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
